# ==============================================================================
# PrepMate / InterviewOS - Environment Configuration
# ==============================================================================
# Copy this file to .env.local or .env in your root directory to configure
# optional cloud storage providers, AI evaluation endpoints, and admin flags.
#
# Default Behavior:
# If no cloud credentials are provided below, PrepMate automatically uses
# high-performance, persistent IndexedDB client storage in the browser.
# All uploaded notes (PDFs, PPTs, DOCs, TXT, Images) will persist across
# reloads, restarts, and sessions without requiring external cloud accounts.
# ==============================================================================

# Storage Provider Option: 'indexeddb' (default), 'cloudinary', or 's3'
VITE_STORAGE_PROVIDER=indexeddb

# ------------------------------------------------------------------------------
# 1. Cloudinary Storage Configuration (Optional)
# ------------------------------------------------------------------------------
# If you want uploaded college notes stored permanently in Cloudinary:
# 1. Create a free account at https://cloudinary.com
# 2. Go to Settings > Upload > Upload Presets and create an unsigned preset
#    (e.g., 'prepmate_notes').
# 3. Enter your Cloud Name and Preset below:
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
# Optional API Key (for server-side signing if using backend proxy):
VITE_CLOUDINARY_API_KEY=your_cloudinary_api_key

# ------------------------------------------------------------------------------
# 2. AWS S3 / MinIO / S3-Compatible Storage Configuration (Optional)
# ------------------------------------------------------------------------------
# If using an S3 bucket or MinIO instance for private educational documents:
VITE_S3_ENDPOINT=https://s3.amazonaws.com
VITE_S3_BUCKET=your-prepmate-study-notes-bucket
VITE_S3_REGION=us-east-1
VITE_S3_ACCESS_KEY_ID=your_s3_access_key
VITE_S3_SECRET_ACCESS_KEY=your_s3_secret_key

# ------------------------------------------------------------------------------
# 3. Admin Security & Access Control
# ------------------------------------------------------------------------------
# Passcode used by administrators to access the /admin/learning-content portal.
# Default fallback passcode is: 'admin123'
VITE_ADMIN_ACCESS_CODE=admin123

# ------------------------------------------------------------------------------
# 4. Optional AI Interview & Evaluation Keys
# ------------------------------------------------------------------------------
VITE_AI_API_KEY=your_gemini_or_openai_api_key
